# Sao chép thành .env là chạy được ngay (cp .env.example .env). KHÔNG commit .env.
# Dev local (pnpm dev) dùng Redis qua cổng host; trong Docker, compose ghi đè REDIS_URL=redis://redis-v2:6379
REDIS_URL=redis://127.0.0.1:6380
PORT=3001

ADMIN_USERNAME=admin
# Mặc định cho demo nội bộ: mật khẩu admin123@ . Đổi bằng: pnpm admin-hash --write
ADMIN_PASSWORD_HASH='$2b$12$qlXD3YTd.rXz9tC43s0d2eR60SjyTfYMdRJX6En4WVDl2k0rlqbi2'

SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
# Danh sách origin được phép gửi request ghi (phân tách bằng dấu phẩy)
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# Cổng host (tùy chọn)
REDIS_HOST_PORT=6380
REDISINSIGHT_HOST_PORT=5541
API_HOST_PORT=3001
WEB_HOST_PORT=5173

# Chỉ dùng cho test
REDIS_TEST_URL=redis://127.0.0.1:6390
